# NEXON Open API 키 (없으면 목업 모드로 실행)
NEXON_API_KEY=

# 포트
PORT=3000

# ── 마영전 v2 엔드포인트 경로 ──
# /id 는 확인된 경로. 나머지는 Open API 문서(openapi.nexon.com/ko/game/heroes)의 실제 경로로 맞춰 주세요.
NEXON_BASE=https://open.api.nexon.com/heroes/v2
NEXON_PATH_OCID=/id
NEXON_PATH_BASIC=/character/basic
NEXON_PATH_STAT=/character/stat
NEXON_PATH_EQUIP=/character/item-equipment
NEXON_PATH_AUCTION=/marketplace/market-history
NEXON_AUCTION_ITEM_PARAM=item_name

# 키가 있어도 목업으로 돌리고 싶으면 1
MOCK=0
